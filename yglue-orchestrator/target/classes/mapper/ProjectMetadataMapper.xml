<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.yglue.flow.orch.persistence.mapper.ProjectMetadataMapper">

    <resultMap id="ProjectMetadataResultMap" type="org.yglue.flow.orch.domain.ProjectMetadata">
        <id property="id" column="id"/>
        <result property="projectId" column="project_id"/>
        <result property="contentJson" column="content_json"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <insert id="insert" parameterType="org.yglue.flow.orch.domain.ProjectMetadata" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO yglue_project_metadata (project_id, content_json, create_by, update_by)
        VALUES (#{projectId}, #{contentJson}, #{createBy}, #{updateBy})
    </insert>

    <select id="selectByProject" resultMap="ProjectMetadataResultMap">
        SELECT id, project_id, content_json, create_time, create_by, update_time, update_by, del_flag
        FROM yglue_project_metadata
        WHERE project_id = #{projectId}
          AND del_flag = 0
        ORDER BY create_time DESC
    </select>
</mapper>
