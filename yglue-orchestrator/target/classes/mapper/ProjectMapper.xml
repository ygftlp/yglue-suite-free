<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.yglue.flow.orch.persistence.mapper.ProjectMapper">

    <resultMap id="ProjectResultMap" type="org.yglue.flow.orch.domain.Project">
        <id property="id" column="id"/>
        <result property="key" column="project_key"/>
        <result property="name" column="name"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="ProjectColumns">
        id, project_key, name, create_time, create_by, update_time, update_by, del_flag
    </sql>

    <insert id="insert" parameterType="org.yglue.flow.orch.domain.Project" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO yglue_project (project_key, name)
        VALUES (#{key}, #{name})
    </insert>

    <select id="selectByKey" resultMap="ProjectResultMap">
        SELECT <include refid="ProjectColumns"/>
        FROM yglue_project
        WHERE project_key = #{projectKey}
          AND del_flag = 0
    </select>

    <select id="selectById" resultMap="ProjectResultMap">
        SELECT <include refid="ProjectColumns"/>
        FROM yglue_project
        WHERE id = #{id}
          AND del_flag = 0
    </select>

    <select id="selectAll" resultMap="ProjectResultMap">
        SELECT <include refid="ProjectColumns"/>
        FROM yglue_project
        WHERE del_flag = 0
        ORDER BY create_time DESC
    </select>

</mapper>
